//kage:unit pixels

package main

var ClipMask bool
var WriteMask bool
var LogicalSize vec2
var UVEffects vec4
var ColorEffects vec4
var TintColor vec3
var HasTint bool
var Nearest bool
var HasFisheye bool
var HasColorEffect bool
var Premultiplied bool
var RepeatedPixels bool

func premultipliedAt(p vec2) vec4 {
	if RepeatedPixels {
		p /= 2
	}
	c := imageSrc0At(imageSrc0Origin() + clamp(p, vec2(0.5), imageSrc0Size()-vec2(0.5)))
	if Premultiplied {
		return c
	}
	return vec4(c.rgb*c.a, c.a)
}

func Fragment(dstPos vec4, srcPos vec2, color vec4, custom vec4) vec4 {
	if WriteMask {
		return vec4(1)
	}
	if ClipMask && imageSrc1UnsafeAt(imageSrc0Origin()+custom.xy).a <= 0 {
		return vec4(0)
	}
	uv := (srcPos - imageSrc0Origin()) / imageSrc0Size()
	/*
		Quad coverage already bounds the sprite. Keep UV=1 boundary samples,
		which can be the only covered pixels of a rotated one-pixel-wide sprite.
	*/
	if UVEffects.x != 1 {
		uv = fract(uv * UVEffects.x)
	}
	if UVEffects.y > 0 {
		n := LogicalSize / UVEffects.y
		uv = (floor(uv*n) + vec2(0.5)) / n
	}
	if UVEffects.z != 0 {
		d := uv - vec2(0.5)
		f := max(1-length(d)*2, 0)
		a := UVEffects.z * f * f
		s, c := sin(a), cos(a)
		uv = vec2(c*d.x+s*d.y, -s*d.x+c*d.y) + vec2(0.5)
	}
	if HasFisheye {
		d := (uv - vec2(0.5)) * 2
		l := length(d)
		if l > 0 {
			r := pow(min(l, 1), UVEffects.w) * max(1, l)
			uv = vec2(0.5) + 0.5*r*d/l
		}
	}
	uv = clamp(uv, vec2(0), vec2(0.99999994))
	p := uv * imageSrc0Size()
	if RepeatedPixels {
		p *= 2
	}
	var c vec4
	if Nearest {
		c = premultipliedAt(floor(p) + vec2(0.5))
	} else {
		base := floor(p-vec2(0.5)) + vec2(0.5)
		f := fract(p - vec2(0.5))
		c = mix(mix(premultipliedAt(base), premultipliedAt(base+vec2(1, 0)), f.x), mix(premultipliedAt(base+vec2(0, 1)), premultipliedAt(base+vec2(1, 1)), f.x), f.y)
	}
	if c.a <= 0 {
		return vec4(0)
	}
	rgb := floor(c.rgb/c.a*255+vec3(0.5)) / 255
	if HasTint {
		rgb *= TintColor
	}
	alpha := floor(c.a*255+0.5) / 255
	if HasColorEffect {
		v := max(rgb.r, max(rgb.g, rgb.b))
		lo := min(rgb.r, min(rgb.g, rgb.b))
		delta := v - lo
		h, s := 0.0, 0.0
		if v > 0 {
			s = delta / v
		}
		if delta > 0 {
			if v == rgb.r {
				h = (rgb.g - rgb.b) / delta
			} else if v == rgb.g {
				h = (rgb.b-rgb.r)/delta + 2
			} else {
				h = (rgb.r-rgb.g)/delta + 4
			}
			h /= 6
		}
		if v < 0.055 {
			h = 0
			s = 1
			v = 0.055
		} else if s < 0.09 {
			h = 0
			s = 0.09
		}
		h = fract(h + ColorEffects.x)
		chroma := v * s
		rgb = clamp(vec3(abs(h*6-3)-1, 2-abs(h*6-2), 2-abs(h*6-4)), vec3(0), vec3(1))*chroma + vec3(v-chroma)
	}
	rgb = floor(clamp(rgb+vec3(ColorEffects.y), vec3(0), vec3(1))*255+vec3(0.5)) / 255
	alpha = floor(alpha*ColorEffects.z*255+0.5) / 255
	return vec4(rgb*alpha, alpha)
}