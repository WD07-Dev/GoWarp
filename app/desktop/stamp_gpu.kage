//kage:unit pixels

package main

func sample(origin, size, p vec2, scale float) vec4 {
	p *= scale
	c := imageSrc0UnsafeAt(origin + clamp(p, vec2(0.5), size-vec2(0.5)))
	/*
		Share the straight-alpha costume texture with the sprite/effect shader.
		Premultiply each texel before interpolation to preserve transparent edges.
	*/
	return vec4(c.rgb*c.a, c.a)
}

// Clamp the costume edge before filtering, as the reference renderer does.
// Opacity is per vertex so different ghost values can share a stamp batch.
func Fragment(dstPos vec4, srcPos vec2, color vec4, custom vec4) vec4 {
	if custom.w < 0 {
		// Lines interleaved with stamps share the batch, in their original order.
		point := dstPos.xy - imageDstOrigin() - color.gb
		delta := custom.xy
		fraction := 0.0
		if squaredLength := dot(delta, delta); squaredLength > 0 {
			fraction = clamp(dot(point, delta)/squaredLength, 0, 1)
		}
		distance := length(point - fraction*delta)
		coverage := clamp(custom.z+0.5-distance, 0, 1)
		if custom.w < -1 {
			coverage = 0
			if distance < custom.z {
				coverage = 1
			}
		}
		rg, ba := floor(color.r+0.5), floor(color.a+0.5)
		red, blue := floor(rg/256), floor(ba/256)
		green, opacity := rg-red*256, ba-blue*256
		alpha := floor(opacity*coverage+0.5) / 255
		return vec4(vec3(red, green, blue)/255*alpha, alpha)
	}
	/*
		Texture bounds travel with each quad. Source-region uniforms would
		prevent the engine from merging different costumes on the same atlas.
	*/
	origin := floor(srcPos - custom.xy + vec2(0.5))
	size := color.rg
	p := srcPos - origin
	filter, scale := custom.w, 1.0
	// Sprites retain the general shader's byte rounding and edge coordinates.
	strict := filter >= 4
	if strict {
		filter -= 4
		p = clamp(p/size, vec2(0), vec2(0.99999994)) * size
	}
	if filter >= 2 {
		filter -= 2
		scale = 0.5
		p *= 2
	}
	var c vec4
	if filter != 0 {
		c = sample(origin, size, floor(p)+vec2(0.5), scale)
	} else {
		base := floor(p-vec2(0.5)) + vec2(0.5)
		f := fract(p - vec2(0.5))
		c = mix(mix(sample(origin, size, base, scale), sample(origin, size, base+vec2(1, 0), scale), f.x),
			mix(sample(origin, size, base+vec2(0, 1), scale), sample(origin, size, base+vec2(1, 1), scale), f.x), f.y)
	}
	/*
		Saturated brightness produces a solid silhouette, independent of hue.
		Keep the general effect shader's byte rounding for opacity.
	*/
	if custom.z <= -1 || custom.z >= 1 {
		alpha := floor(floor(c.a*255+0.5)*color.a+0.5) / 255
		return vec4(vec3((custom.z+1)/2)*alpha, alpha)
	}
	if color.b == 0 && custom.z == 0 && !strict {
		return c * color.a
	}
	if c.a <= 0 {
		return vec4(0)
	}
	// Match the general effect shader, with hue/brightness supplied per quad.
	rgb := floor(c.rgb/c.a*255+vec3(0.5)) / 255
	alpha := floor(c.a*255+0.5) / 255
	if color.b != 0 {
		v := max(rgb.r, max(rgb.g, rgb.b))
		lo := min(rgb.r, min(rgb.g, rgb.b))
		delta := v - lo
		h, s := 0.0, 0.0
		if v > 0 {
			s = delta / v
		}
		if delta > 0 {
			if v == rgb.r {
				h = (rgb.g - rgb.b) / delta
			} else if v == rgb.g {
				h = (rgb.b-rgb.r)/delta + 2
			} else {
				h = (rgb.r-rgb.g)/delta + 4
			}
			h /= 6
		}
		if v < 0.055 {
			h = 0
			s = 1
			v = 0.055
		} else if s < 0.09 {
			h = 0
			s = 0.09
		}
		h = fract(h + color.b)
		chroma := v * s
		rgb = clamp(vec3(abs(h*6-3)-1, 2-abs(h*6-2), 2-abs(h*6-4)), vec3(0), vec3(1))*chroma + vec3(v-chroma)
	}
	rgb = floor(clamp(rgb+vec3(custom.z), vec3(0), vec3(1))*255+vec3(0.5)) / 255
	alpha = floor(alpha*color.a*255+0.5) / 255
	return vec4(rgb*alpha, alpha)
}
