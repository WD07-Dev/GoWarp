//kage:unit pixels
package main

var Blur vec2
var BlurWeights [16]float
var BlurRadius int
var SourceSize vec2

func sample(p vec2) vec4 {
	if p.x < 0 || p.y < 0 || p.x >= SourceSize.x || p.y >= SourceSize.y { return vec4(0) }
	p -= vec2(.5)
	b := floor(p)
	f := fract(p)
	a := imageSrc0At(imageSrc0Origin()+clamp(b,vec2(0),SourceSize-1)+vec2(.5))
	c := imageSrc0At(imageSrc0Origin()+clamp(b+vec2(1,0),vec2(0),SourceSize-1)+vec2(.5))
	d := imageSrc0At(imageSrc0Origin()+clamp(b+vec2(0,1),vec2(0),SourceSize-1)+vec2(.5))
	e := imageSrc0At(imageSrc0Origin()+clamp(b+vec2(1,1),vec2(0),SourceSize-1)+vec2(.5))
	return mix(mix(a,c,f.x),mix(d,e,f.x),f.y)
}

// Merge taps only at exact pixel centers; interpolation can introduce rounding error.
func Fragment(position vec4, texCoord vec2, color vec4) vec4 {
	p := texCoord-imageSrc0Origin()
	axis := vec2(1, 0)
	if Blur.y > 0 { axis = vec2(0, 1) }
	q := dot(p, axis)
	if p-floor(p) == vec2(.5) && q >= float(BlurRadius)+.5 && q <= dot(SourceSize, axis)-float(BlurRadius)-.5 {
		origin := imageSrc0Origin()+p
		c := imageSrc0At(origin)*BlurWeights[0]
		for i := 1; i < 16; i++ {
			if i > BlurRadius { break }
			d := axis*float(i)
			c += (imageSrc0At(origin-d)+imageSrc0At(origin+d))*BlurWeights[i]
		}
		return c
	}
	// Edge taps must be clipped before interpolation, as in the original filter.
	c := vec4(0)
	total := float(0)
	for i := -12; i <= 12; i++ {
		x := float(i)*.25
		w := exp(-x*x/2)
		c += sample(p+Blur*x)*w
		total += w
	}
	return c/total
}